# Copy this file to backend/.env and edit. (Environment variables of the same name win over this file.)
# After running secure_db.py this holds the restricted "pos_app" login instead of the owner login.
DATABASE_URL=postgresql://pos:pos@localhost:5432/pos
# Time zone of the shop: decides what "today" means for the dashboard and reports.
POS_TZ=Asia/Karachi
# How many daily backups to keep (backup.py)
POS_BACKUP_KEEP=14
# Hours a login lasts before the person must log in again (default 12)
# POS_SESSION_HOURS=12
# Which screens may talk to the backend. Default: this computer + the shop's private network (192.168.x.x, 10.x.x.x, 172.16-31.x.x).
# POS_CORS_ORIGIN_REGEX=^https?://(localhost|127\.0\.0\.1)(:\d+)?$
# Secret mixed into PINs. Normally leave unset: backend/pos_secret.key is created automatically (keep a copy of it!).
# POS_SECRET_KEY=
# Only if the first owner account must be created from ANOTHER computer (not recommended):
# POS_ALLOW_REMOTE_SETUP=1
# Which network address the backend listens on. 127.0.0.1 = this computer only (default, safest).
# For tills on other computers set 0.0.0.0 (listen on every connection of this computer; NOT a single LAN address, or this computer itself can no longer reach it) AND choose the approved
# connection in Settings -> Network. Windows will ask once to allow it through the firewall.
# POS_BIND_HOST=127.0.0.1
# Cash drawer: none (record only, default) or command (runs POS_DRAWER_COMMAND, a JSON list, to pulse the drawer)
# POS_DRAWER_DRIVER=none
# POS_DRAWER_COMMAND=["C:\\pos\\open-drawer.exe"]
# How often the background checker looks at the network/backups (seconds)
# POS_MONITOR_SECONDS=10

# ── v12 ──
# Set to 1 once the POS runs over HTTPS (start.bat sets it for you when backend\certs exists). Makes the sign-in cookie HTTPS-only.
# POS_COOKIE_SECURE=1
# Wrong sign-ins allowed from ONE computer in 5 minutes before it must wait (default 30).
# POS_THROTTLE_MAX=30
